{
  "manifest_version": 3,
  "name": "PagePath · 网页迷宫",
  "version": "3.0.0",
  "description": "把当前网页变成水墨迷宫。全范围随机难度，以星级显示挑战，探索出口、赢取积分、提升等级；地图与游戏进度均在本地处理。",
  "minimum_chrome_version": "103",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "PagePath · 点击开始 / 关闭",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; connect-src 'none'" }
}
